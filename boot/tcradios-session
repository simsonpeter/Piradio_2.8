#!/usr/bin/env bash
# Start the radio on the display the login manager already opened.
# Do not launch Wayland/labwc here: the LCD35 kiosk is X11, and labwc
# would fail and leave the boot splash on screen forever.
export DISPLAY="${DISPLAY:-:0}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-TCRADIOS}"
export XDG_SESSION_DESKTOP=TCRADIOS

if command -v openbox >/dev/null 2>&1 && [[ -S /tmp/.X11-unix/X${DISPLAY#:} || -S /tmp/.X11-unix/X0 ]]; then
    exec openbox --startup /usr/local/bin/tcradios-start
fi
exec /usr/local/bin/tcradios-start
