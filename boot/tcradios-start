#!/usr/bin/env bash
# Last working radio launch: dismiss splash, then start Python.
set -u

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
timeout 2 plymouth quit >/dev/null 2>&1 || true

exec 9>"/tmp/tcradios-${UID:-0}.lock"
if ! flock -n 9; then
    echo "tcradios already running $(date -Is)"
    exit 0
fi
# This launcher owns the lock. End a player left behind by an older copy.
# Only kill Python itself. A shell whose command mentions the file is not the player.
stopped_player=0
for pid in $(pgrep -f '[t]ouch_radio.py' || true); do
    cmd="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
    base="${cmd%% *}"
    base="${base##*/}"
    case "${base}" in
        python|python3|python3.*)
            kill -9 "${pid}" >/dev/null 2>&1 || true
            stopped_player=1
            ;;
    esac
done
if [[ "${stopped_player}" == 1 ]]; then
    sleep 0.2
fi

if [[ ! -t 1 ]]; then
    exec >>"${HOME}/.tcradios-start.log" 2>&1
fi
echo "tcradios-start $(date -Is) ${DISPLAY:-:0} ${REPO_DIR}"

export DISPLAY="${DISPLAY:-:0}"
DISPLAY_NUMBER="${DISPLAY#:}"
for _ in {1..40}; do
    if [[ -S "/tmp/.X11-unix/X${DISPLAY_NUMBER}" ]]; then
        break
    fi
    sleep 0.25
done
sleep 1

timeout 2 plymouth quit >/dev/null 2>&1 || true

cd "${REPO_DIR}"
QUIT_FLAG="${HOME}/.tcradios-user-quit"
rm -f "${QUIT_FLAG}"
while true; do
    /usr/bin/python3 "${REPO_DIR}/touch_radio.py"
    code=$?
    if [[ -f "${QUIT_FLAG}" ]]; then
        rm -f "${QUIT_FLAG}"
        echo "tcradios user quit $(date -Is)"
        exit 0
    fi
    echo "tcradios exited ${code} $(date -Is), starting again"
    sleep 2
done
